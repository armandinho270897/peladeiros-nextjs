# Copie esse arquivo pra .env.local e preenche com os valores do seu projeto Supabase
# (Project Settings -> API, no painel do supabase.com)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role" (Project Settings -> API -> Project API keys).
# NUNCA prefixa com NEXT_PUBLIC_ — essa chave ignora RLS e só pode ser usada
# server-side (rotas /api). Se vazar pro navegador, qualquer um lê/escreve o banco todo.
SUPABASE_SERVICE_ROLE_KEY=

# Token de acesso da Jawg Maps (app.jawg.io/access-tokens) — usado nas tiles
# escuras do mapa (lib/leafletIcon.js). Sem isso a URL do tile fica com
# "access-token=undefined" e o mapa não carrega nenhum tile.
NEXT_PUBLIC_JAWG_ACCESS_TOKEN=

# Conta Gmail usada pra enviar e-mail transacional (login por link mágico,
# avisos urgentes) via SMTP (lib/sendEmail.js). GMAIL_APP_PASSWORD é uma
# senha de app (myaccount.google.com/apppasswords), não a senha da conta.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Opcional — monitoramento de erros (Sentry). Sem isso o app funciona normal,
# só não reporta exceções.
NEXT_PUBLIC_SENTRY_DSN=

# Opcional — só usadas no build pra subir sourcemap pro Sentry (org/projeto/
# token em sentry.io). Sem elas o build funciona normal, só pula esse upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Opcional — autentica as chamadas de cron (app/api/cron/**). Sem isso as
# rotas de cron aceitam a chamada sem checar, mesmo comportamento de hoje.
CRON_SECRET=
